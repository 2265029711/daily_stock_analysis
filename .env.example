# ===================================
# A股自选股智能分析系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实配置
# ===================================

# 自选股列表（逗号分隔，支持沪深两市代码）
# 沪市：600xxx, 601xxx, 603xxx
# 深市：000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# 数据源配置
# Tushare Pro Token（可选，从 https://tushare.pro 获取）
TUSHARE_TOKEN=your_tushare_token_here

# ===================================
# AI 模型配置（OpenAI 兼容格式，三项必填）
# ===================================
# 支持所有 OpenAI 格式 API：OpenAI、DeepSeek、通义千问、Moonshot、智谱GLM 等
#
# ┌──────────────────────────────────────────────────────────────┐
# │ 必填配置：                                                    │
# │   OPENAI_API_KEY    = API Key                                 │
# │   OPENAI_BASE_URL   = API 地址                                │
# │   OPENAI_MODEL      = 模型名称（按供应商文档填写）             │
# └──────────────────────────────────────────────────────────────┘
#
# --- DeepSeek ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# --- 通义千问 ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
#
# --- Moonshot（Kimi）---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k
#
# --- 智谱 GLM ---
# OPENAI_API_KEY=xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4-flash
#
# --- OpenAI 官方 ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# API 请求流控（防止 429 限流）
# OPENAI_REQUEST_DELAY=2.0   # 请求间隔（秒）
# OPENAI_MAX_RETRIES=5       # 最大重试次数
# OPENAI_RETRY_DELAY=5.0     # 重试基础延时（秒）

# 搜索引擎配置（用于获取股票新闻）
# Tavily API Keys 支持两种格式：
#   方式一（推荐）：一个 key 一行
#     TAVILY_API_KEY_1=tvly-key1
#     TAVILY_API_KEY_2=tvly-key2
#   方式二（兼容）：逗号分隔单行
#     TAVILY_API_KEYS=tvly-key1,tvly-key2
# 某个 Key 配额用尽（429/402）时自动冷却 30 天并切换下一个 Key（自动轮询）
TAVILY_API_KEY_1=your_tavily_key_here
# TAVILY_API_KEYS=your_tavily_key_here
# SerpAPI Keys（支持多个，逗号分隔）
SERPAPI_KEYS=your_serpapi_key_here

# 企业微信机器人 Webhook URL（可选，与 Bark 二选一或同时配置）
WECHAT_WEBHOOK_URL=

# Bark 推送（iOS 通知，可选，与企微二选一或同时配置）
# 从 Bark App 获取设备 Key（https://apps.apple.com/cn/app/id1403753865）
# BARK_DEVICE_KEY=your_bark_device_key
# BARK_SERVER_URL=https://api.day.app   # 自建服务器时改为自己的地址
# BARK_GROUP=股票分析
#
# 多用户推送：复制 push_config.example.yaml 为 push_config.yaml 后配置
# 各用户的 device_key 支持 ${ENV} 占位符，如：
# BARK_KEY_USER_A=your_bark_device_key_a
# BARK_KEY_USER_B=your_bark_device_key_b

# 数据库路径
DATABASE_PATH=./data/stock_analysis.db

# === 定时任务配置 ===
# 是否启用定时任务（true/false）
SCHEDULE_ENABLED=false
# 每日执行时间（HH:MM 格式，24小时制）
SCHEDULE_TIME=18:00
# 是否启用大盘复盘（true/false）
MARKET_REVIEW_ENABLED=true

# 系统配置
# 日志目录
LOG_DIR=./logs
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
# 最大并发线程数（建议保持低并发防封禁）
MAX_WORKERS=3
# 是否启用调试日志
DEBUG=false
